   "formato": "objetiva",
   "anulada": false,
   "dificuldade": null,
   "alternativas": [
    {
     "id": 20036271,
     "letra": "A",
     "descricao": "Hidrocortisona, 100 mg de 8 em 8 horas, no dia do procedimento",
     "isResposta": 1,
     "ordem": 1
    },
    {
     "id": 20036272,
     "letra": "B",
     "descricao": "Reiniciar corticosteróides uma semana antes da cirurgia",
     "isResposta": 0,
     "ordem": 2
    },
    {
     "id": 20036273,
     "letra": "C",
     "descricao": "Aminofilina, 240 mg, 1 hora antes da cirurgia",
     "isResposta": 0,
     "ordem": 3
    },
    {
     "id": 20036274,
     "letra": "D",
     "descricao": "Nenhuma medida com relação à asma brônquica",
     "isResposta": 0,
     "ordem": 4
    }
   ],
   "origem": {
